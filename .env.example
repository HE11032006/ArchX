# Copy this file to .env and fill in the values you need.
# Never commit the real .env file.

# --- Dataset generation (dataset_generation/generate_dataset.py) ---
# API key for the Teacher model, via OpenRouter (OpenAI-compatible).
OPENROUTER_API_KEY=sk-or-v1-...

# --- API / inference (api/config.py) ---
# Path to the fine-tuned Gemma LoRA adapter (e.g. ./architect-insight-lora-final).
# Leave unset to force mock inference.
ARCHX_MODEL_PATH=

# Force mock inference regardless of ARCHX_MODEL_PATH (true/false).
# If unset, defaults to true only when ARCHX_MODEL_PATH is empty.
ARCHX_MOCK_INFERENCE=

# Temp directory used for shallow-cloning public GitHub repos before analysis.
ARCHX_CLONE_DIR=tmp/clones

# Git clone timeout, in seconds.
ARCHX_CLONE_TIMEOUT=120

# Shallow clone depth (git history) fetched for hotspot analysis.
ARCHX_CLONE_DEPTH=500
